# MEIKA environment template
# Copy this file to `.env` and fill in the real values.
# IMPORTANT: never commit the real `.env` (it contains your API key).
# `.env` is git-ignored for this reason.

# OpenAI-compatible API endpoint (bluesminds in this setup)
API_BASE_URL=https://api.bluesminds.com/v1

# Your provider API key - REPLACE WITH YOUR REAL KEY
API_KEY=YOUR_API_KEY

# Primary model
MODEL=gpt-5.2-chat

# Optional: comma-separated fallback pool used on rate-limit / cooldown
MODEL_POOL=gpt-5.2-chat,gpt-4.0-chat

# Optional push notifications via Pushover
# PUSHOVER_USER=...
# PUSHOVER_TOKEN=...
