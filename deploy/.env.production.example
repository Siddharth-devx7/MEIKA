# MEIKA production environment (VPS)
# This file is copied to /etc/meika/.env by deploy/install.sh.
# PUT YOUR REAL VALUES HERE.  NEVER commit the real key to git.

API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
MODEL=gemini-2.5-flash

# Comma-separated fallback pool (optional)
# MODEL_POOL=gemini-2.5-flash,gemini-2.0-flash

# Run mode for systemd: bind Gradio to 0.0.0.0:$PORT
MEIKA_MODE=vps
PORT=8080

# Optional push notifications
# PUSHOVER_USER=...
# PUSHOVER_TOKEN=...
