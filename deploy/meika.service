[Unit]
Description=MEIKA - Unified AI Interactive Dashboard (Gradio)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meika
EnvironmentFile=/etc/meika/.env
ExecStart=/opt/meika/venv/bin/python meika.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
